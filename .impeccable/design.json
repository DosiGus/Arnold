      "css": ".ds-back{display:inline-flex;align-items:center;gap:0.5rem;min-height:var(--ac-tap,2.75rem);min-width:var(--ac-tap,2.75rem);padding:0.25rem 0;border:0;border-radius:0.25rem;background:transparent;color:var(--text,#171717);font:0.8125rem system-ui,sans-serif;text-align:start;cursor:pointer;} .ds-back:hover{background:transparent;} .ds-back:focus-visible{outline:2px solid var(--focus,#171717);outline-offset:3px;}"
