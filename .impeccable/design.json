      "html": "<section class=\"ds-card\"><span class=\"ds-label\">Dein Training</span><h2>Heute trainieren</h2><p>Änderungen gehen auch im Chat.</p></section>",
      "css": ".ds-card{display:grid;gap:0.875rem;padding:var(--ac-pad,1.25rem);border:1px solid var(--border,#e5e5e5);border-radius:var(--ac-radius,1rem);background:var(--card,#fff);color:var(--text,#171717);box-shadow:none;backdrop-filter:none;font:0.9375rem/1.45 system-ui,sans-serif;} .ds-card h2{margin:0;font-size:1.75rem;line-height:1.15;font-weight:500;letter-spacing:-0.025em;} .ds-card p{margin:0;font-size:0.875rem;color:var(--muted,#666);} .ds-label{font-size:0.75rem;font-weight:500;color:var(--muted,#666);}"
