# What `gcloud run deploy --source .` uploads to Cloud Build.
#
# Allowlist: everything at the top level is excluded, then only the build
# inputs and the runtime files are let back in. A new top-level file or
# folder (a worktree, an audit, test output) stays out until it is named here.
# Keep in step with .dockerignore. Check with:
#   gcloud meta list-files-for-upload .
/*
!/package.json
!/package-lock.json
!/Dockerfile
!/.dockerignore
!/tsconfig.json
!/tsconfig.server.json
!/vite.config.ts
!/vite.host.config.ts
!/vite.views.config.ts
!/dashboard.html
!/host.html
!/src/
!/public/

# Never, wherever they sit inside the allowed folders.
.DS_Store
.env*
secrets
credentials
*.pem
*.key
service-account*.json
service_account*.json
*-credentials.json
