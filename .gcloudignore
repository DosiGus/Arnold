# What `gcloud run deploy --source .` must never upload. Mirrors .dockerignore
# and keeps every secret-shaped file out of the Cloud Build source archive.
.gcloudignore
.git
.github
node_modules
dist
data
test-results
playwright-report
.env*
.codex
.agents
secrets
credentials
*.pem
*.key
service-account*.json
service_account*.json
*-credentials.json
