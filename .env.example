# Optional: node --env-file=.env dist/server/main.js
# Never commit real values; .env* files are ignored.
PORT=8787
HOST=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For the official basic-host example, add http://localhost:8080 explicitly.
ALLOWED_ORIGINS=
# Number of reverse proxies allowed to set X-Forwarded-*. Off when unset.
# Behind Cloud Run (TLS ends at Google's front end) set 1, or the preview's
# own https origin is refused. Never set it on a directly exposed process.
# TRUST_PROXY=1
# One JSON log line per MCP tool call (tool, outcome, error code, duration;
# never arguments or results). Cloud Run sets it.
# ARNOLD_TOOL_LOG=json
# Card interface: skybridge (default, one file per view in dist/views) or
# legacy (the former bundle in dist/ui). Anything else stops the start.
# ARNOLD_UI=skybridge
# Release id shown on /health (the deploy sets the commit). Letters, digits,
# dot, dash, underscore; anything else stops the start.
# ARNOLD_RELEASE=

# ─── Profiles ───
# With STORAGE_MODE unset the server runs arnold_fixture: invented data in
# memory, every tool available, no account.
#   arnold_fixture   synthetic (default; set ARNOLD_WRITE_MODE=fixture with it)
#   arnold_database  signed-in users, data in Postgres (Supabase), below
# STORAGE_MODE=arnold_fixture
# ARNOLD_WRITE_MODE=fixture

# ─── Login (docs/GUIDE.md) ───
# Validated at startup and FAIL-CLOSED: a contradictory setting stops the
# process rather than silently degrading.

# development | staging | production. Drives every strictness check below.
# ARNOLD_ENV=development

# open | oidc. open = no token check, synthetic data only, development only.
# AUTH_MODE=oidc

# Arnold's public origin, and its resource identifier (the token's aud).
# ARNOLD_PUBLIC_BASE_URL=https://arnold.example.com
# ARNOLD_MCP_RESOURCE_URL=https://arnold.example.com/mcp

# The login provider (WorkOS AuthKit). Arnold only VERIFIES tokens.
# AUTH_ISSUER=https://auth.example.com/
# AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# AUTH_AUDIENCE=https://arnold.example.com/mcp
# AUTH_AUTHORIZATION_SERVER=https://auth.example.com/
# Read Arnold's scopes from this claim (WorkOS JWT template).
# AUTH_SCOPE_CLAIM=urn:arnold:scopes

# ─── Database profile (arnold_database) ───
# STORAGE_MODE=arnold_database
# AUTH_MODE=oidc
# IDENTITY_STORE=postgres
# The server's own role (arnold_app, no superuser, row level security applies).
# On Supabase: the session pooler address with user arnold_app.<project-ref>.
# DATABASE_URL=postgres://arnold_app.<project-ref>:<password>@<pooler-host>:5432/postgres
# Connections per instance (1-50, default 10).
# DATABASE_MAX_CONNECTIONS=10
# Days that write receipts and audit events are kept (default 30).
# ARNOLD_JOURNAL_RETENTION_DAYS=30

# Only for `npm run db:migrate` and `npm run db:setup`, never for the server:
# the owner connection (Supabase: user postgres).
# DATABASE_ADMIN_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
