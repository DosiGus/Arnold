# Optional: node --env-file=.env dist/server/main.js
PORT=8787
HOST=127.0.0.1
DEMO_DATA_FILE=data/demo.json
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For the official basic-host example, add http://localhost:8080 explicitly.
ALLOWED_ORIGINS=

# Optional private, read-only Google Sheets profile (use a separate port).
# STORAGE_MODE=google_sheets
# MCP_ACCESS=private
# PORT=8788
# GOOGLE_SPREADSHEET_ID=<selected-file-id>
# GOOGLE_SHEET_ID=<numeric-tab-id>
# GOOGLE_SHEET_TITLE=Trainingslog
# GOOGLE_HEADER_ROW=4
# GOOGLE_MAX_ROWS=20004
# GOOGLE_APPLICATION_CREDENTIALS=data/google-sheets-reader.json
# Keep HOST/ALLOWED_HOSTS loopback-only and ALLOWED_ORIGINS empty.
# Never route this profile through the public demo tunnel.

# Optional private, read-only Arnold schema v1 profile (v2 dashboard, own port).
# STORAGE_MODE=arnold_sheets
# MCP_ACCESS=private
# PORT=8789
# ARNOLD_SPREADSHEET_ID=<arnold-workbook-file-id>
# GOOGLE_APPLICATION_CREDENTIALS=data/google-sheets-reader.json
# Optional guards: the read fails instead of showing the wrong file.
# ARNOLD_EXPECTED_FILE_ROLE=USER_TRACKER
# ARNOLD_EXPECTED_TRACKER_ID=<tracker-id-from-CONFIG>
# ARNOLD_CACHE_TTL_MS=15000
# Keep HOST/ALLOWED_HOSTS loopback-only and ALLOWED_ORIGINS empty.
# Never route this profile through the public demo tunnel.

# Task 004: explicit synthetic Arnold logger (no Google calls, no real accounts).
# STORAGE_MODE=arnold_fixture
# ARNOLD_WRITE_MODE=fixture
# PORT=8795
# Default ARNOLD_WRITE_MODE=disabled keeps existing demo/read connections unchanged.
# production is always rejected. test_sheet requires an injected verified backend
# actor, dedicated test workbook, audit/ledger/coordinator, and loopback binding;
# it cannot be enabled using environment flags or MCP_ACCESS=private alone.
