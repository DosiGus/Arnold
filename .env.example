# Optional: node --env-file=.env dist/server/main.js
PORT=8787
HOST=127.0.0.1
DEMO_DATA_FILE=data/demo.json
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For the official basic-host example, add http://localhost:8080 explicitly.
ALLOWED_ORIGINS=

# Optional private, read-only Google Sheets profile (use a separate port).
# STORAGE_MODE=google_sheets
# MCP_ACCESS=private
# PORT=8788
# GOOGLE_SPREADSHEET_ID=<selected-file-id>
# GOOGLE_SHEET_ID=<numeric-tab-id>
# GOOGLE_SHEET_TITLE=Trainingslog
# GOOGLE_HEADER_ROW=4
# GOOGLE_MAX_ROWS=20004
# GOOGLE_APPLICATION_CREDENTIALS=data/google-sheets-reader.json
# Keep HOST/ALLOWED_HOSTS loopback-only and ALLOWED_ORIGINS empty.
# Never route this profile through the public demo tunnel.

# Optional private, read-only Arnold schema v1 profile (v2 dashboard, own port).
# STORAGE_MODE=arnold_sheets
# MCP_ACCESS=private
# PORT=8789
# ARNOLD_SPREADSHEET_ID=<arnold-workbook-file-id>
# GOOGLE_APPLICATION_CREDENTIALS=data/google-sheets-reader.json
# Optional guards: the read fails instead of showing the wrong file.
# ARNOLD_EXPECTED_FILE_ROLE=USER_TRACKER
# ARNOLD_EXPECTED_TRACKER_ID=<tracker-id-from-CONFIG>
# ARNOLD_CACHE_TTL_MS=15000
# Keep HOST/ALLOWED_HOSTS loopback-only and ALLOWED_ORIGINS empty.
# Never route this profile through the public demo tunnel.

# ─── Task 007-A: MCP authentication (docs/ARNOLD-AUTH-ARCHITECTURE.md) ───
# Validated at startup and FAIL-CLOSED: a contradictory setting stops the
# process rather than silently degrading. Never commit real values here.

# development | staging | production. Drives every strictness check below;
# there is no override.
# ARNOLD_ENV=development

# open | oidc. Defaults to open in development and oidc everywhere else.
# open = the pre-Task-007 behaviour: no bearer validation, read-only and
# synthetic data only, every write class refused. Rejected outside development.
# ARNOLD_MODE_NOTE: setting AUTH_MODE=open while AUTH_ISSUER is also set is
# refused — that combination looks like active authentication and is not.
# AUTH_MODE=oidc

# Arnold's public origin, and its RFC 8707 resource identifier. The resource id
# defaults to <base>/mcp and is the value the authorization server must put in
# the token's aud claim. Both must be https in production.
# ARNOLD_PUBLIC_BASE_URL=https://arnold.example.com
# ARNOLD_MCP_RESOURCE_URL=https://arnold.example.com/mcp

# The authorization server. Arnold only ever VERIFIES tokens — it issues none,
# so there is no client secret for this layer. No provider has been chosen yet.
# AUTH_ISSUER=https://auth.example.com/
# AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# AUTH_AUDIENCE defaults to ARNOLD_MCP_RESOURCE_URL.
# AUTH_AUTHORIZATION_SERVER defaults to AUTH_ISSUER.
# AUTH_AUDIENCE=https://arnold.example.com/mcp
# AUTH_AUTHORIZATION_SERVER=https://auth.example.com/

# memory | file | postgres. production requires postgres.
# NOTE: the postgres store is NOT IMPLEMENTED yet (Task 007-D) and throws.
# IDENTITY_STORE=file
# IDENTITY_STORE_FILE=data/identity.json
# DATABASE_URL=postgres://user:password@host:5432/arnold

# Google OAuth (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI)
# and TOKEN_ENCRYPTION_KEY_REF belong to Task 007-B and are NOT IMPLEMENTED.
# Do not add Google client secrets to this repository.
