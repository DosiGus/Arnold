# Optional: node --env-file=.env dist/server/main.js
PORT=8787
HOST=127.0.0.1
DEMO_DATA_FILE=data/demo.json
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For the official basic-host example, add http://localhost:8080 explicitly.
ALLOWED_ORIGINS=

# Optional private, read-only Google Sheets profile (use a separate port).
# STORAGE_MODE=google_sheets
# MCP_ACCESS=private
# PORT=8788
# GOOGLE_SPREADSHEET_ID=<selected-file-id>
# GOOGLE_SHEET_ID=<numeric-tab-id>
# GOOGLE_SHEET_TITLE=Trainingslog
# GOOGLE_HEADER_ROW=4
# GOOGLE_MAX_ROWS=20004
# GOOGLE_APPLICATION_CREDENTIALS=data/google-sheets-reader.json
# Keep HOST/ALLOWED_HOSTS loopback-only and ALLOWED_ORIGINS empty.
# Never route this profile through the public demo tunnel.
