# Optional: node --env-file=.env dist/server/main.js
PORT=8787
HOST=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For the official basic-host example, add http://localhost:8080 explicitly.
ALLOWED_ORIGINS=
# Number of reverse proxies allowed to set X-Forwarded-*. Off when unset.
# Behind Cloud Run (TLS ends at Google's front end) set 1, or the preview's
# own https origin is refused. Never set it on a directly exposed process.
# TRUST_PROXY=1

# With STORAGE_MODE unset the server runs arnold_fixture: invented data in
# memory, every tool available, no Google account. Profiles:
#   arnold_fixture   synthetic (default; set ARNOLD_WRITE_MODE=fixture with it)
#   arnold_sheets    read-only, one real Arnold workbook (below)
#   arnold_connected per-user Google files with OIDC (below)

# Optional private, read-only Arnold profile (own port).
# STORAGE_MODE=arnold_sheets
# MCP_ACCESS=private
# PORT=8789
# ARNOLD_SPREADSHEET_ID=<arnold-workbook-file-id>
# GOOGLE_APPLICATION_CREDENTIALS=data/google-sheets-reader.json
# Optional guards: the read fails instead of showing the wrong file.
# ARNOLD_EXPECTED_FILE_ROLE=USER_TRACKER
# ARNOLD_EXPECTED_TRACKER_ID=<tracker-id-from-CONFIG>
# ARNOLD_CACHE_TTL_MS=15000
# Keep HOST/ALLOWED_HOSTS loopback-only and ALLOWED_ORIGINS empty.
# Never route this profile through the public demo tunnel.

# Synthetic Arnold (no Google calls, no real accounts). This is the default;
# setting it explicitly requires both lines.
# STORAGE_MODE=arnold_fixture
# ARNOLD_WRITE_MODE=fixture
# ARNOLD_WRITE_MODE=disabled (the default) keeps read-only profiles read-only.
# production is always rejected. test_sheet requires an injected verified backend
# actor, dedicated test workbook, audit/ledger/coordinator, and loopback binding;
# it cannot be enabled using environment flags or MCP_ACCESS=private alone.

# ─── Task 007-A: MCP authentication (docs/GUIDE.md) ───
# Validated at startup and FAIL-CLOSED: a contradictory setting stops the
# process rather than silently degrading. Never commit real values here.

# development | staging | production. Drives every strictness check below;
# there is no override.
# ARNOLD_ENV=development

# open | oidc. Defaults to open in development and oidc everywhere else.
# open = the pre-Task-007 behaviour: no bearer validation, read-only and
# synthetic data only, every write class refused. Rejected outside development.
# ARNOLD_MODE_NOTE: setting AUTH_MODE=open while AUTH_ISSUER is also set is
# refused — that combination looks like active authentication and is not.
# AUTH_MODE=oidc

# Arnold's public origin, and its RFC 8707 resource identifier. The resource id
# defaults to <base>/mcp and is the value the authorization server must put in
# the token's aud claim. Both must be https in production.
# ARNOLD_PUBLIC_BASE_URL=https://arnold.example.com
# ARNOLD_MCP_RESOURCE_URL=https://arnold.example.com/mcp

# The authorization server. Arnold only ever VERIFIES tokens — it issues none,
# so there is no client secret for this layer. No provider has been chosen yet.
# AUTH_ISSUER=https://auth.example.com/
# AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# AUTH_AUDIENCE defaults to ARNOLD_MCP_RESOURCE_URL.
# AUTH_AUTHORIZATION_SERVER defaults to AUTH_ISSUER.
# AUTH_AUDIENCE=https://arnold.example.com/mcp
# AUTH_AUTHORIZATION_SERVER=https://auth.example.com/
# Read Arnold's scopes from this namespaced claim instead of `scope`, for
# providers that only grant their own scopes to self-registered clients
# (WorkOS AuthKit: set it through the environment's JWT template). When set,
# only this claim counts. Must look like urn:<namespace>:<name>.
# AUTH_SCOPE_CLAIM=urn:arnold:scopes

# memory | file | postgres. production requires postgres.
# NOTE: the postgres store is NOT IMPLEMENTED yet (Task 007-D) and throws.
# IDENTITY_STORE=file
# IDENTITY_STORE_FILE=data/identity.json
# DATABASE_URL=postgres://user:password@host:5432/arnold

# ─── Task 007-B: Google OAuth (docs/GUIDE.md) ───
# NEVER commit a real client secret or encryption key. These values belong in a
# secret manager; the names below are only how the process reads them.

# From the OAuth client in Google Cloud. The redirect URI must match the one
# registered there EXACTLY — Arnold always sends its own configured value and
# never one taken from a request parameter.
# GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<client-secret>
# GOOGLE_REDIRECT_URI=https://arnold.example.com/auth/google/callback

# Scopes are NOT configurable: Arnold requests openid, email and
# drive.file, and refuses a grant that is broader (see src/server/google/scopes.ts).
# A consequence worth knowing before planning features: drive.file means Arnold
# cannot search your Drive or open a sheet you merely name. Importing an
# existing sheet needs its own picker flow.

# Refresh tokens are encrypted at rest with AES-256-GCM. Format <kid>:<base64>,
# where the key is exactly 32 bytes. Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=k1:<base64-32-bytes>
# Retired keys stay readable during rotation; comma-separated, same format.
# Rotation order: add the new key as TOKEN_ENCRYPTION_KEY, move the old one
# here, re-wrap rows, then drop it.
# TOKEN_ENCRYPTION_KEYS_OLD=k0:<base64-32-bytes>

# ─── Connected end-to-end development profile ───
# See docs/GUIDE.md. Explicit opt-in; a single process only.
# Uses the OIDC and Google client/key settings above. No service-account key.
# Requires a real OIDC provider configured to issue the Arnold resource audience
# and the arnold.read, arnold.write, arnold.plan, arnold.account scopes.
# The browser preview cannot sign in by itself; use an authenticated MCP host.
# STORAGE_MODE=arnold_connected
# ARNOLD_ENV=development
# AUTH_MODE=oidc
# IDENTITY_STORE=file
# IDENTITY_STORE_FILE=data/connected/identities.json
# ARNOLD_STATE_DIRECTORY=data/connected
# ARNOLD_WRITE_MODE=disabled
# The runtime enables checked per-user writes itself. Do NOT set fixture,
# test_sheet or production here. staging/production are rejected by this profile.
# GOOGLE_REDIRECT_URI must equal <ARNOLD_PUBLIC_BASE_URL>/auth/google/callback.
# Keep data/connected and TOKEN_ENCRYPTION_KEY together in an encrypted backup.
