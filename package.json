{
  "name": "arnold",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx watch src/server/main.ts",
    "build:ui": "vite build && vite build --config vite.host.config.ts",
    "build": "npm run typecheck && npm run build:ui && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "deploy:cloud-run": "bash scripts/deploy-cloud-run.sh",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:setup": "bash scripts/setup-database.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:auth": "vitest run tests/auth-",
    "test:security": "vitest run tests/auth-token-verifier tests/auth-isolation tests/auth-config",
    "test:integration": "vitest run tests/auth-http tests/mcp.test.ts",
    "check": "npm run build && npm test && npm run test:e2e",
    "inspector": "npx @modelcontextprotocol/inspector@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "garmin:check": "bash apps/garmin/scripts/build.sh && bash apps/garmin/scripts/test.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "5.0.5"
  }
}
