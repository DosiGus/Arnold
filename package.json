{
  "name": "arnold",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx watch src/server/main.ts",
    "build:ui": "vite build && vite build --config vite.host.config.ts",
    "build": "npm run typecheck && npm run build:ui && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "inspector": "npx @modelcontextprotocol/inspector@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "5.0.5"
  }
}
